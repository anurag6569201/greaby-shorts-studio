# Django Core
SECRET_KEY=your-django-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Database (PostgreSQL recommended for production)
DATABASE_URL=sqlite:///db.sqlite3

# CORS - Your React Frontend URL
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Celery & Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# Azure AI Services
AZURE_ENDPOINT_URL=https://your-azure-endpoint.openai.azure.com/
AZURE_SORA_DEPLOYMENT_NAME=sora
# NOTE: Azure credentials (AZURE_TENANT_ID, AZURE_CLIENT_ID, AZURE_CLIENT_SECRET) for DefaultAzureCredential should be set in your shell environment.

# Cloud Storage (Example for Azure Postgres)
DATABASE_URL='postgres://postgre6569201:{password}@postgre6569201.postgres.database.azure.com:5432/{database-name}?sslmode=require'
